rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function owns(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function validNote(data) {
      return data.keys().hasAll([
          'userId', 'title', 'isPinned', 'createdAt', 'updatedAt',
          'tags', 'content', 'color', 'images'
        ])
        && data.keys().hasOnly([
          'userId', 'title', 'isPinned', 'createdAt', 'updatedAt',
          'tags', 'content', 'color', 'images', 'imageUrls', 'taskIdentities'
        ])
        && data.userId == request.auth.uid
        && (data.title is string || data.title == null)
        && data.isPinned is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.tags is list
        && data.content is string
        && data.color is int
        && data.images is list
        && (!data.keys().hasAny(['imageUrls']) || data.imageUrls is list)
        && (!data.keys().hasAny(['taskIdentities']) || data.taskIdentities is list);
    }

    function validProject(data) {
      return data.keys().hasAll([
          'userId', 'name', 'description', 'status', 'priority', 'deadline',
          'targetMinutesPerWeek', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'name', 'description', 'status', 'priority', 'deadline',
          'targetMinutesPerWeek', 'createdAt', 'updatedAt'
        ])
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.description is string
        && data.status in ['active', 'paused', 'completed', 'archived']
        && data.priority in ['none', 'low', 'medium', 'high', 'critical']
        && (data.deadline is timestamp || data.deadline == null)
        && (data.targetMinutesPerWeek is int || data.targetMinutesPerWeek == null)
        && (data.targetMinutesPerWeek == null || data.targetMinutesPerWeek >= 0)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validReminder(data) {
      return data.keys().hasAll([
          'userId', 'noteId', 'taskLineIndex', 'notePreview', 'scheduledAt',
          'isCompleted', 'repeat', 'notificationId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'noteId', 'taskLineIndex', 'notePreview', 'scheduledAt',
          'isCompleted', 'repeat', 'notificationId', 'createdAt', 'updatedAt',
          'title', 'repeatIntervalMinutes', 'taskId'
        ])
        && data.userId == request.auth.uid
        && data.noteId is string
        && (data.taskLineIndex is int || data.taskLineIndex == null)
        && (data.get('taskId', null) == null || data.get('taskId', null) is string)
        && data.notePreview is string
        && (!data.keys().hasAny(['title']) || data.title is string)
        && data.scheduledAt is timestamp
        && data.isCompleted is bool
        && data.repeat in ['none', 'daily', 'weekly', 'interval']
        && (data.repeat == 'interval'
          ? data.get('repeatIntervalMinutes', null) is int
            && data.repeatIntervalMinutes >= 15
          : data.get('repeatIntervalMinutes', null) == null)
        && data.notificationId is int
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validProfile(userId, data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.displayName is string
        && data.email is string
        && (data.photoUrl is string || data.photoUrl == null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSchedulingPreferences(value) {
      return value is map
        && value.keys().hasAll([
          'isConfigured', 'dayStartMinutes', 'dayEndMinutes',
          'availableWeekdays', 'minimumBlockMinutes', 'preferredBlockMinutes',
          'breakMinutes', 'maxFocusMinutesPerDay', 'defaultTaskMinutes',
          'protectLunch', 'lunchStartMinutes', 'lunchEndMinutes'
        ])
        && value.keys().hasOnly([
          'isConfigured', 'dayStartMinutes', 'dayEndMinutes',
          'availableWeekdays', 'minimumBlockMinutes', 'preferredBlockMinutes',
          'breakMinutes', 'maxFocusMinutesPerDay', 'defaultTaskMinutes',
          'protectLunch', 'lunchStartMinutes', 'lunchEndMinutes'
        ])
        && value.isConfigured is bool
        && value.dayStartMinutes is int
        && value.dayStartMinutes >= 0
        && value.dayStartMinutes < 1440
        && value.dayEndMinutes is int
        && value.dayEndMinutes > value.dayStartMinutes
        && value.dayEndMinutes < 1440
        && value.availableWeekdays is list
        && value.availableWeekdays.size() > 0
        && value.minimumBlockMinutes is int
        && value.minimumBlockMinutes >= 15
        && value.minimumBlockMinutes <= 240
        && value.preferredBlockMinutes is int
        && value.preferredBlockMinutes >= value.minimumBlockMinutes
        && value.preferredBlockMinutes <= 360
        && value.breakMinutes is int
        && value.breakMinutes >= 0
        && value.breakMinutes <= 120
        && value.maxFocusMinutesPerDay is int
        && value.maxFocusMinutesPerDay >= value.minimumBlockMinutes
        && value.maxFocusMinutesPerDay <= 960
        && value.defaultTaskMinutes is int
        && value.defaultTaskMinutes >= 15
        && value.defaultTaskMinutes <= 480
        && value.protectLunch is bool
        && value.lunchStartMinutes is int
        && value.lunchStartMinutes >= 0
        && value.lunchStartMinutes < 1440
        && value.lunchEndMinutes is int
        && value.lunchEndMinutes >= 0
        && value.lunchEndMinutes < 1440
        && (value.protectLunch == false
          || (value.lunchStartMinutes >= value.dayStartMinutes
            && value.lunchEndMinutes > value.lunchStartMinutes
            && value.lunchEndMinutes <= value.dayEndMinutes));
    }

    function validAutomationPreferences(value) {
      return value is map
        && value.keys().hasAll(['level'])
        && value.keys().hasOnly(['level'])
        && value.level in ['observe', 'suggest', 'approval', 'trusted'];
    }

    function validSettings(data) {
      return data.keys().hasAll([
          'themeMode', 'defaultNoteTag', 'notificationsEnabled',
          'smartRemindersEnabled', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'themeMode', 'defaultNoteTag', 'notificationsEnabled',
          'smartRemindersEnabled', 'scheduling', 'automation', 'updatedAt'
        ])
        && data.themeMode in ['system', 'light', 'dark']
        && data.defaultNoteTag is string
        && data.notificationsEnabled is bool
        && data.smartRemindersEnabled is bool
        && (!data.keys().hasAny(['scheduling'])
          || validSchedulingPreferences(data.scheduling))
        && (!data.keys().hasAny(['automation'])
          || validAutomationPreferences(data.automation))
        && data.updatedAt is timestamp;
    }

    match /notes/{noteId} {
      allow read, delete: if owns(resource.data);
      allow create: if signedIn() && validNote(request.resource.data);
      allow update: if owns(resource.data)
        && validNote(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
    }

    match /projects/{projectId} {
      allow read, delete: if owns(resource.data);
      allow create: if signedIn() && validProject(request.resource.data);
      allow update: if owns(resource.data)
        && validProject(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
    }

    match /reminders/{reminderId} {
      allow read, delete: if owns(resource.data);
      allow create: if signedIn() && validReminder(request.resource.data);
      allow update: if owns(resource.data)
        && validReminder(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
    }

    match /users/{userId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
        && validProfile(userId, request.resource.data);

      match /settings/{settingsId} {
        allow read: if isUser(userId);
        allow create, update: if isUser(userId)
          && settingsId == 'app'
          && validSettings(request.resource.data);
        allow delete: if isUser(userId) && settingsId == 'app';
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
